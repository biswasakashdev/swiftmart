
# Types

type User {
    id: ID!
    email: String!
    name: String!
}

type Authorization{
    token: String!
    user: User!
}

# Inputs

input CredentialsInput{
    emailOrPhone : String!
    password : String!
}

input CreateUserInput{
    email: String!
    countryCode: String!
    phone: String!
    password: String!
    name: String!
}

# Mutations
extend type Mutation{
    authorize(inp: CredentialsInput!) :Authorization!

    createUser(inp: CreateUserInput!): Boolean!

}






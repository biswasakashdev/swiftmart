# Types
type Shop{
    id: ID!
    name: String!
    role:String!
    status: String!
    revenue: Int!
    productCount: Int!
    orderCount: Int!
    lastActive: String!
}

type ShopList{
    pageDetails: PageDetails!
    content:[Shop!]!
}

# Inputs

input CreateShopInput{
    name: String!,
    description: String!
}

extend type Query {
    shops(pageInfo: PageInfo!): ShopList!

    shop(shopId: String!): Shop!
}

extend type Mutation {
    createShop(inp:CreateShopInput!) : Shop!
}